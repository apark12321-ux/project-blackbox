# ─── Project Blackbox — Module A: 환경변수 ───

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# News API (newsapi.org)
NEWS_API_KEY=your_news_api_key_here

# Google Gemini API (콘텐츠 정제용)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://blackbox:password@localhost:5432/blackbox_db

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# Server
HOST=0.0.0.0
PORT=8000
