# ═══════════════════════════════════════════════════════
# AlgoMaker 환경변수 설정 가이드
# ═══════════════════════════════════════════════════════
# 박예준 대표님 안내:
# 1. Vercel 대시보드 → 프로젝트 → Settings → Environment Variables
# 2. 아래 변수들을 하나씩 추가
# 3. 모든 환경 (Production, Preview, Development)에 동일하게 설정
# ═══════════════════════════════════════════════════════

# ─────────────────────────────────────────────────
# 🌐 사이트 기본 정보 (필수)
# ─────────────────────────────────────────────────

# 박 대표님 도메인 (nutube.kr 연결 후)
NEXT_PUBLIC_SITE_URL=https://nutube.kr

# ─────────────────────────────────────────────────
# 💰 Google AdSense (승인 후 입력)
# ─────────────────────────────────────────────────

# AdSense 승인 받으면 → 대시보드에서 Publisher ID 복사
# 형식: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# 광고 슬롯 ID들 (AdSense 대시보드에서 광고 단위 만들고 복사)
# 슬롯명은 AdSlot 컴포넌트에서 사용한 이름과 매칭
NEXT_PUBLIC_ADSENSE_SLOT_PUBLISH_MID=
NEXT_PUBLIC_ADSENSE_SLOT_PUBLISH_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_CREATE_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_IMAGEGEN_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# ─────────────────────────────────────────────────
# 🔍 Search Console 인증 (선택사항이지만 권장)
# ─────────────────────────────────────────────────

# Google Search Console (search.google.com/search-console)
# 1. 새 속성 추가 → 도메인 입력
# 2. "HTML 태그" 인증 방식 선택
# 3. content="..." 부분만 복사해서 여기 입력
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Naver Search Advisor (searchadvisor.naver.com)
NEXT_PUBLIC_NAVER_VERIFICATION=

# Yandex (선택)
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ─────────────────────────────────────────────────
# 📊 Google Analytics 4 (선택사항이지만 권장)
# ─────────────────────────────────────────────────

# analytics.google.com에서 GA4 속성 만들고 측정 ID 복사
# 형식: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────
# 🔐 백엔드 (Railway)
# ─────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=https://project-blackbox-production.up.railway.app

# ═══════════════════════════════════════════════════════
# 📌 AdSense 승인 신청 순서:
# ═══════════════════════════════════════════════════════
#
# 1. 사이트 배포 (현재)
# 2. nutube.kr 도메인 연결 (Vercel)
# 3. NEXT_PUBLIC_SITE_URL 환경변수 설정
# 4. 사이트에 콘텐츠 충분히 채우기 (블로그/노하우 15개 이상 권장)
# 5. Google Search Console 등록 → 인증
# 6. 1~2개월 후 AdSense 승인 신청
#    - https://adsense.google.com 에서 신청
#    - 도메인 입력: nutube.kr
# 7. 승인 코드 받으면:
#    - NEXT_PUBLIC_ADSENSE_CLIENT 환경변수 설정
#    - public/ads.txt 파일의 Publisher ID 교체
# 8. 광고 단위 만들기 → 슬롯 ID 환경변수 설정
#
# ═══════════════════════════════════════════════════════
