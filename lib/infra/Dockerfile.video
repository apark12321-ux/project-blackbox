FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg curl && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY module_b2/ module_b2/
COPY module_b/core/script_engine.py module_b/core/script_engine.py
COPY infra/ infra/

EXPOSE 8001
CMD ["uvicorn", "module_b2.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]
