# ═══════════════════════════════════════════════
# Project Blackbox — Environment Configuration
# ═══════════════════════════════════════════════

# ── Database ──
POSTGRES_USER=blackbox
POSTGRES_PASSWORD=blackbox_secure_2026
POSTGRES_DB=blackbox
DATABASE_URL=postgresql+asyncpg://blackbox:blackbox_secure_2026@postgres:5432/blackbox

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── API Keys (replace with real values) ──
GEMINI_API_KEY=your_gemini_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
HEYGEN_API_KEY=your_heygen_api_key
NEWS_API_KEY=your_news_api_key
YOUTUBE_API_KEY=your_youtube_api_key

# ── App Settings ──
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,https://blackbox.app

# ── File Paths ──
OUTPUT_DIR=/app/output
ASSETS_DIR=/app/assets
BGM_PATH=/app/assets/bgm/default.mp3
